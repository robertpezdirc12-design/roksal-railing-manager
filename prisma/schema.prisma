// Roksal Railing Manager — REKONSTRUKCIJA (R431)
// Vir: blueprint iz GitLab recovery repo (route-map, RBAC katalog R425–R428, IA register R429)
// Original: Next.js 16 + Prisma (PostgreSQL/Neon) — tu: SQLite (sandbox)
// SPORAZUM: ta shema je EN VIR — module (subagenti) NE spreminjajo sheme!

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Identiteta & dostop ────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String // ADMIN | VODJA | MONTER | SKLADISCE | PROIZVODNJA
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  auditLogs    AuditLog[]
  workOrders   WorkOrder[]     @relation("assignee")
  woEvents     WorkOrderEvent[]
  measurements Measurement[]
  measVersions MeasurementVersion[] @relation("measurementVersions")
  equipHeld    Equipment[]     @relation("equipmentHolder")
  equipLogs    EquipmentCheckout[] @relation("equipmentUser")
  qcChecks     QcCheck[]       @relation("qcUser")
  jobRuns      JobRun[]
  punchEntries PunchEntry[]    @relation("punchUser") // R437: prisotnost
  stockMovements StockMovement[] @relation("stockMovements") // R443: skladiščni dnevnik
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// ─── CRM ────────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  taxId     String?
  note      String?
  createdAt DateTime @default(now())

  projects Project[]
  quotes   Quote[]
  leads    Lead[]
}

model Lead {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  name       String
  email      String?
  phone      String?
  source     String    @default("SPLET") // SPLET | TELEFON | PRIPOROČILO | SEJEM
  status     String    @default("NOV") // NOV | KONTAKTIRAN | KVALIFIKACIJAN | IZGUBLJEN | PRETVORJEN
  note       String?
  createdAt  DateTime  @default(now())

  opportunities Opportunity[]
}

model Opportunity {
  id           String    @id @default(cuid())
  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id])
  title        String
  stage        String    @default("KVALIFIKACIJA") // KVALIFIKACIJA | PONUDBA | POGAJANJA | ZMAGOVALNA | IZGUBLJENA
  value        Float     @default(0)
  probability  Int       @default(50)
  expectedClose DateTime?
  note         String?
  createdAt    DateTime  @default(now())
}

// ─── Projekti & ponudbe ─────────────────────────────────────────────────────

model Project {
  id         String    @id @default(cuid())
  code       String    @unique // npr. P-2026-001
  title      String
  status     String    @default("AKTIVNI") // NACRT | AKTIVNI | TEREN | ZAKLJUCEN | ARHIV
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  address    String?
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  quotes           Quote[]
  workOrders       WorkOrder[]
  measurements     Measurement[]
  invoices         Invoice[]
  productionOrders ProductionOrder[]
  warranties       Warranty[]
  portalLinks      PortalLink[]
  packages         ProjectPackage[] // R442: več produktnih paketov na projekt
  stockReservations StockReservation[] @relation("stockReservations") // R443: rezervacije materiala
}

model Quote {
  id         String    @id @default(cuid())
  code       String    @unique // npr. PON-2026-001
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  status     String    @default("OSNUTEK") // OSNUTEK | POSLAN | SPREJET | ZAVRNJEN | ZAKLENJEN
  subtotal   Float     @default(0)
  vat        Float     @default(0)
  total      Float     @default(0)
  note       String?
  signature  String? // podpis stranke (data URL)
  signedAt   DateTime?
  signedBy   String?
  createdAt  DateTime  @default(now())

  lines   QuoteLine[]
  invoices Invoice[]
}

model QuoteLine {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  qty         Float
  unitPrice   Float
  total       Float
}

model Invoice {
  id        String    @id @default(cuid())
  code      String    @unique // npr. RA-2026-001
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id])
  quoteId   String?
  quote     Quote?    @relation(fields: [quoteId], references: [id])
  status    String    @default("IZDAN") // OSNUTEK | IZDAN | DELNO_PLACAN | PLACAN | ZAPRT
  subtotal  Float     @default(0)
  vat       Float     @default(0)
  total     Float     @default(0)
  paid      Float     @default(0)
  dueDate   DateTime?
  note      String?
  createdAt DateTime  @default(now())

  payments Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  method    String   @default("NAKAZNICA") // NAKAZNICA | GOTOVINA | KARTICA
  reference String?
  createdAt DateTime @default(now())
}

// ─── Nalogi (terenski tok) ──────────────────────────────────────────────────

model WorkOrder {
  id           String    @id @default(cuid())
  code         String    @unique // npr. N-2026-001
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id])
  title        String
  status       String    @default("NAPROGRAMIRAN") // NAPROGRAMIRAN | V_TEKU | V_ZAJEMU | V_PREVERI | ZAKLJUCEN
  assigneeId   String?
  assignee     User?     @relation("assignee", fields: [assigneeId], references: [id])
  scheduledFor DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  summary      String?
  instructions String? // navodila za monterja (pisarna → teren)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  events       WorkOrderEvent[]
  measurements Measurement[]
}

model WorkOrderEvent {
  id          String     @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])
  type        String // DODELJEN | ZACETEK | ZAJEM | PREVERITEV | ZAKLJUCEK | KOMENTAR | OPOMBA (R439: sync)
  note        String?
  createdAt   DateTime   @default(now())
}

// ─── Zajem (meritve, foto) ──────────────────────────────────────────────────

model Measurement {
  id          String      @id @default(cuid())
  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id])
  workOrderId String?
  workOrder   WorkOrder?  @relation(fields: [workOrderId], references: [id])
  authorId    String?
  author      User?       @relation(fields: [authorId], references: [id])
  type        String      @default("OGRAJA") // legacy tip (OGRAJA | BALUSTRADA | NAGIB | OSTANEO)
  familyCode  String? // R442: produktna družina (TERASA | OGRAJA_PRECNA | FASADA | …) — generalizacija meritev
  location    String?
  lengthCm    Float?
  heightCm    Float?
  posts       Int?
  segments    Int?
  handrail    Boolean     @default(true)
  slopeDeg    Float?
  source      String      @default("ROCNO") // ROCNO | KAMERA (večtočkovne meritve na fotografiji)
  params      String? // JSON (profileId, barva, photoId, points, calibration, viz, konfigurator …)
  note        String?
  // R437 (issue #2): javna deljena povezava meritve (žeton /m/[token] izvirnika → /api/public/measure?token=)
  shareToken  String?     @unique
  createdAt   DateTime    @default(now())

  versions    MeasurementVersion[]
  packages    ProjectPackage[] @relation("packageMeasurements") // R442: paketi, vezani na to izmero
}

// Zgodovina verzij meritev — posnetek stanja ob vsaki spremembi (issue #1: zgodovina verzij)
model MeasurementVersion {
  id           String   @id @default(cuid())
  measurement  Measurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  measurementId String
  version      Int
  data         String   // JSON posnetek (type, lengthCm, heightCm, posts, slopeDeg, note, params …)
  userId       String?
  user         User?    @relation("measurementVersions", fields: [userId], references: [id])
  note         String?
  createdAt    DateTime @default(now())

  @@index([measurementId, version])
}

// ─── Katalog & zaloga ───────────────────────────────────────────────────────

model Profile {
  id          String  @id @default(cuid())
  sku         String  @unique
  name        String
  material    String  @default("ALU") // ALU | INOX | KOVANO ŽELEZO | STIKLO
  type        String  @default("OGRAJA") // OGRAJA | BALUSTRADA | NAGIBNA
  pricePerM   Float   @default(0)
  description String?
  active      Boolean @default(true)
}

model InventoryItem {
  id        String   @id @default(cuid())
  sku       String   @unique
  name      String
  unit      String   @default("m") // m | kos | kg | l
  qty       Float    @default(0)
  reorderAt Float    @default(0)
  location  String?
  createdAt DateTime @default(now())

  lots   StockLot[]
  prices MaterialPrice[]
  // R442: produktni model — EKSPlicitne ID povezave (vir resnice za BOM)
  bomTemplates ProductComponent[] @relation("inBomTemplates")
  bomLines     BomLine[]          @relation("inBomLines")
  priceRules   PriceRule[]        @relation("itemPriceRules")
  // R443: skladiščni tok — gibanja, rezervacije, picking
  movements    StockMovement[]    @relation("stockMovements")
  reservations StockReservation[] @relation("stockReservations")
  pickingLines PickingLine[]      @relation("pickingLines")
}

model StockLot {
  id          String   @id @default(cuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  qty         Float
  unitCost    Float    @default(0)
  supplierId  String?
  deliveredAt DateTime @default(now())
}

model Supplier {
  id    String  @id @default(cuid())
  name  String
  email String?
  phone String?
  note  String?
}

model MaterialPrice {
  id         String        @id @default(cuid())
  itemId     String?
  item       InventoryItem? @relation(fields: [itemId], references: [id])
  supplierId String?
  price      Float
  createdAt  DateTime      @default(now())
}

// ─── Orodjarina (merilna orodja, izposoja) ──────────────────────────────────

model Equipment {
  id             String   @id @default(cuid())
  code           String   @unique // npr. OR-001
  name           String
  category       String   @default("MERITEV") // MERITEV | MONTAZA | PREVERITEV | VZDRZEVANJE
  serialNumber   String?
  status         String   @default("NA_VOLJO") // NA_VOLJO | IZPOSOJENO | V_SERVISU | POKVARJENO
  holderId       String? // trenutni imetnik (denormalizirano iz zadnje izposoje)
  holder         User?    @relation("equipmentHolder", fields: [holderId], references: [id])
  location       String?
  calibrationDue DateTime? // rok umeritve / kalibracije
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  checkouts EquipmentCheckout[]
}

model EquipmentCheckout {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation("equipmentUser", fields: [userId], references: [id])
  outAt       DateTime  @default(now())
  inAt        DateTime? // null = še izposojeno
  note        String?
}

// ─── Proizvodnja ────────────────────────────────────────────────────────────

model ProductionOrder {
  id        String    @id @default(cuid())
  code      String    @unique // npr. PR-2026-001
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id])
  title     String
  status    String    @default("NAVRTEN") // NAVRTEN | V_IZDELAVI | DOKONCAN | ODPOSLAN
  dueAt     DateTime?
  note      String?
  createdAt DateTime  @default(now())

  qcChecks QcCheck[]
}

// ─── Kontrola kakovosti (R434 — vir: /api/qc iz ROUTE-MAP) ──────────────────

model QcCheck {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  item              String // kontrolna točka, npr. "Vertikalnost stebričev"
  result            String          @default("V_TEKU") // OK | NOK | NA | V_TEKU
  note              String?
  userId            String?
  user              User?           @relation("qcUser", fields: [userId], references: [id])
  createdAt         DateTime        @default(now())
}

// ─── Garancija (R434 — vir: /api/warranty iz ROUTE-MAP) ─────────────────────

model Warranty {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startsAt  DateTime        @default(now())
  months    Int             @default(24)
  status    String          @default("AKTIVNA") // AKTIVNA | POTEKLA | PREKINJENA
  note      String?
  createdAt DateTime        @default(now())

  visits WarrantyVisit[]
}

model WarrantyVisit {
  id         String    @id @default(cuid())
  warrantyId String
  warranty   Warranty  @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  date       DateTime  @default(now())
  note       String?
  userId     String?
  createdAt  DateTime  @default(now())
}

// ─── Revizija & obvestila ───────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // npr. LOGIN, LOGOUT, QUOTE_ISSUE, PAYMENT_RECORD, WO_TRANSITION, USER_ROLE_CHANGE …
  entity    String // ime entitete (invoice, workOrder …)
  entityId  String?
  projectId String? // null = sistemski dogodek (R428: globalni pregled)
  detail    String? // JSON
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── Obvestila in komunikacija (R438: issue #5 — event → notification model) ─
// En poslovni dogodek (NotificationEvent) = en vir resnice; več kanalov
// (NotificationDelivery) porabi isti event. Retry je varen pred podvajanjem (key + unique).

model NotificationEvent {
  id        String   @id @default(cuid())
  key       String   @unique // dedup: npr. "wo-assign:<nalogId>:<assigneeId>"
  type      String // WO_ASSIGNED | WO_TERMIN | … (NOTIFICATION_EVENT_TYPES v notify-events.ts)
  payload   String // JSON { title, body, customerEmail?, customerName? }
  projectId String?
  createdAt DateTime @default(now())

  deliveries NotificationDelivery[]
}

model NotificationDelivery {
  id        String    @id @default(cuid())
  eventId   String
  event     NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  channel   String // IN_APP | EMAIL | SMS | WHATSAPP
  userId    String? // prejemnik-app uporabnik (IN_APP)
  recipient String? // prikriti zunanji naslov (e-pošta/telefon — NIKOLI celoten)
  status    String    @default("PENDING") // PENDING | SENT | FAILED | SKIPPED
  attempts  Int       @default(0)
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@unique([eventId, channel, userId]) // dedup dostave (userId null za zunanje)
  @@index([status, attempts])
}

// Nastavitve obveščanja po uporabniku (R438): event '*' = vsi dogodki.
model NotificationPref {
  id      String  @id @default(cuid())
  userId  String
  event   String // tip dogodka (ali * = vse)
  channel String // IN_APP | EMAIL | SMS
  enabled Boolean @default(true)

  @@unique([userId, event, channel])
}

// ─── Portal stranke (R435: /p/[token] izvirnika → javni API + predogled) ────

model PortalLink {
  id           String    @id @default(cuid())
  token        String    @unique // neuraden žeton URL /api/public/portal?token=…
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  note         String? // interne opombe (npr. "poslano na e-pošto")
  views        Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
}

// ─── Nastavitve sistema (R435: licenca/aktivacija, setup) ───────────────────

model Setting {
  key       String   @id // npr. "licence.key", "licence.status"
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Vzdrževalna opravila (R435: cron jobs izvirnika → ročni zagon + dnevnik) ─

model JobRun {
  id         String   @id @default(cuid())
  job        String // seje-gc | portal-gc | obvestila-gc
  ok         Boolean
  affected   Int      @default(0)
  detail     String? // JSON
  startedAt  DateTime
  finishedAt DateTime
  userId     String? // null = sistemski/cron zagon
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ─── Nabava materiala (R437: /api/material-orders iz route-mape izvirnika) ──

model MaterialOrder {
  id         String    @id @default(cuid())
  code       String    @unique // npr. NAR-2026-001
  supplierId String? // skalarno (enako kot MaterialPrice/StockLot)
  status     String    @default("PRIPRAVA") // PRIPRAVA | POSLANO | PREJETO | PREKINJENO
  note       String?
  createdBy  String?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?
  receivedAt DateTime?

  lines MaterialOrderLine[]
}

model MaterialOrderLine {
  id        String  @id @default(cuid())
  orderId   String
  order     MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    String? // povezava na artikel (opcijsko)
  itemName  String // denormalizirano ime (artikel lahko izgine)
  qty       Float
  unit      String  @default("m")
  unitPrice Float   @default(0)
}

// ─── Prisotnost (R437: /api/punch iz route-mape izvirnika) ──────────────────

model PunchEntry {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("punchUser", fields: [userId], references: [id], onDelete: Cascade)
  day       String // lokalni dan YYYY-MM-DD
  inAt      DateTime?
  outAt     DateTime?
  note      String?
  createdAt DateTime  @default(now())

  @@unique([userId, day]) // ena prijava/odjava na dan
}

// ─── Inženirska pravila (R437: /api/engineering-rules iz route-mape) ────────

model EngineeringRule {
  id        String   @id @default(cuid())
  key       String   @unique // npr. max_razdalja_stebrov
  label     String // človeško berljivo ime
  value     Float
  unit      String   @default("cm")
  note      String?
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// ─── Offline sinhronizacija (R439: issue #6 — mobilni teren brez signala) ────
// SyncOp = zadetek uspešno obdelanega opa iz /api/sync. id = opId (UUID, ga
// generira ODJEMALEC) → ponovno pošiljanje istega opId vrne shranjen rezultat
// (idempotenca — podvajanje meritev/dogodkov NI mogoče).

model SyncOp {
  id        String   @id // opId (UUID, generira odjemalec) — idempotenca
  deviceId  String
  userId    String
  kind      String // meritev | foto | nalog-opomba | nalog-status | nalog-zakljucek
  result    String // JSON odgovor operacije
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── Ankete / povpraševanja (R437: /api/surveys iz route-mape izvirnika) ────

model Survey {
  id        String   @id @default(cuid())
  name      String // ime kontaktirane osebe
  email     String?
  phone     String?
  type      String   @default("OGRAJA") // tip zahteve (OGRAJA | STOPNISCE | TERASA | DRUGO)
  lengthCm  Float? // ocenjena dolžina
  location  String?
  message   String?
  handled   Boolean  @default(false) // obdelano v pisarni
  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════════════════
// PRODUKTNI MODEL (R442 — issue #7 §1–§6, P0 DATA CORE)
// Vir resnice za izdelke, variante, komponente, BOM, cene in pakete projektov.
// Profile (zgoraj) ostaja kot LEGACY za stari railing konfigurator (viz/kalkulator)
// — nova poslovna logika MORA uporabljati ta model z EKSPPLICITNIMI ID povezavami.
// PostgreSQL-kompatibilno: samo skalarni tipi + JSON kot String (issue #7 §14).
// ═══════════════════════════════════════════════════════════════════════════

// ─── Produktna družina (issue #7 §1) ────────────────────────────────────────

model ProductFamily {
  id        String   @id @default(cuid())
  code      String   @unique // TERASA | OGRAJA_PRECNA | OGRAJA_POKOCNA | FASADA | PREGRADA | NAPUSC | STROP | STOPNICE | VRTNA_RESITEV | KOMPONENTA
  name      String
  desc      String?
  unit      String   @default("m2") // glavna enota družine: m2 | m | kos
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

// ─── Produkt (prodajni izdelek; issue #7 §1: SKU, enota, dimenzije, cene …) ─

model Product {
  id             String        @id @default(cuid())
  familyId       String
  family         ProductFamily @relation(fields: [familyId], references: [id])
  sku            String        @unique
  name           String
  desc           String?
  unit           String        @default("m2") // prodajna enota: m2 | m | kos
  // dimenzije (mm)
  widthMm        Int?
  heightMm       Int?
  depthMm        Int?
  // tehnične lastnosti (JSON): material, ral, obremenitev, toplotna prevodnost …
  tech           String?
  // osnovni ceni (nabavna/prodajna na enoto); veljavne cene razrešuje PriceList
  costPrice      Float         @default(0)
  salePrice      Float         @default(0)
  warrantyMonths Int           @default(24)
  active         Boolean       @default(true)
  validFrom      DateTime      @default(now())
  validTo        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  variants      ProductVariant[]
  components    ProductComponent[] @relation("bomTemplate")
  boms          Bom[]
  packages      ProjectPackage[]
  priceRules    PriceRule[]      @relation("productPriceRules")
}

// ─── Varianta produkta (barva/RAL, dimenzija; issue #7 §1) ──────────────────

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String   @unique
  name      String // npr. "WPC terasa — Grafit"
  color     String? // človeško berljivo ime barve
  ral       String? // npr. "RAL 7016"
  widthMm   Int?
  heightMm  Int?
  // override ceni (null = podeduje produkt)
  costPrice Float?
  salePrice Float?
  tech      String? // JSON dopolnilne tehnične lastnosti
  active    Boolean  @default(true)
  sortOrder Int      @default(0)

  packages ProjectPackage[]
  boms     Bom[]
}

// ─── Komponenta produkta (BOM PREDLOGA; issue #7 §2) ────────────────────────
// EKSPlicitna ID povezava productId → itemId (InventoryItem).
// qty = količina artikla na ENOTO osnove (unitBasis) produkta.
// Primer: TERASA → WPC deska 1.05 m² na m² (vključen odpad).

model ProductComponent {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation("bomTemplate", fields: [productId], references: [id], onDelete: Cascade)
  itemId    String
  item      InventoryItem @relation("inBomTemplates", fields: [itemId], references: [id])
  qty       Float // količina na enoto osnove
  unitBasis String        @default("m2") // m2 | m | kos — osnova produkta
  optional  Boolean       @default(false)
  note      String?
  sortOrder Int           @default(0)
}

// ─── Kosovnica (generirana BOM; issue #7 §2 + §5) ───────────────────────────
// Nastane iz predloge (ProductComponent) × količina paketa.
// Vrstice kazajo EKSPlicitno na InventoryItem — nikoli na imena.

model Bom {
  id        String           @id @default(cuid())
  code      String           @unique // npr. BOM-2026-001
  packageId String?           @unique // povezava na projektni paket (izmera/ponudba; 1:1)
  package   ProjectPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  productId String
  product   Product          @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant?  @relation(fields: [variantId], references: [id])
  qty       Float // količina (v enoti produkta)
  unit      String // m2 | m | kos
  status    String           @default("OSNUTEK") // OSNUTEK | POTRJEN | REZERVIRAN | PORABLJEN | PREKLICAN
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  lines BomLine[]
  // R443: skladiščni tok vezan na kosovnico
  reservations StockReservation[] @relation("bomReservations")
  pickings     PickingList[]      @relation("bomPickings")
}

model BomLine {
  id        String        @id @default(cuid())
  bomId     String
  bom       Bom           @relation(fields: [bomId], references: [id], onDelete: Cascade)
  itemId    String // EKSPlicitna povezava na artikel
  item      InventoryItem @relation("inBomLines", fields: [itemId], references: [id])
  qty       Float
  unit      String
  note      String?
  sortOrder Int           @default(0)
}

// ─── Ceniki (issue #7 §6: poslovne cene NISO hardcoded) ─────────────────────

model PriceList {
  id        String   @id @default(cuid())
  name      String // npr. "Prodajni cenik 2026"
  type      String   @default("PRODAJNA") // NABAVNA | PRODAJNA | MONTAZA
  currency  String   @default("EUR")
  validFrom DateTime @default(now())
  validTo   DateTime?
  active    Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules PriceRule[]
}

model PriceRule {
  id          String        @id @default(cuid())
  priceListId String
  priceList   PriceList     @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  // cilj pravila: produkt (prodajna cena) ali artikel (nabavna/montažna)
  productId   String?
  product     Product?      @relation("productPriceRules", fields: [productId], references: [id], onDelete: Cascade)
  itemId      String?
  item        InventoryItem? @relation("itemPriceRules", fields: [itemId], references: [id], onDelete: Cascade)
  price       Float
  unit        String        @default("m2")
  discountPct Float         @default(0)
  minPrice    Float? // najnižja dovoljena cena
  seasonFrom  String? // MM-DD (sezonska cena)
  seasonTo    String? // MM-DD
  note        String?
  active      Boolean       @default(true)
  validFrom   DateTime      @default(now())
  validTo     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([priceListId, active])
}

// ─── Projektni paket (issue #7 §3: projekt = več rešitev) ───────────────────
// Primer: P-2026-014 → TERASA 36,4 m² + OGRAJA 18,6 m + NAPUŠČ 24 m².

model ProjectPackage {
  id            String          @id @default(cuid())
  code          String          @unique // npr. PAK-P-2026-014-1
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  measurementId String? // povezava na izmero (generalizirana)
  measurement   Measurement?    @relation("packageMeasurements", fields: [measurementId], references: [id], onDelete: SetNull)
  name          String // prikazno ime, npr. "Terasa — WPC Grafit"
  qty           Float           @default(0) // količina v enoti produkta
  unit          String          @default("m2")
  status        String          @default("POVPRAŠEVANJE") // POVPRAŠEVANJE | IZMERA | KONFIGURACIJA | PONUDBA | POTRJENO | REZERVIRANO | V_IZDELAVI | DOSTAVLJENO | MONTIRANO | PREDANO
  calcJson      String? // JSON kalkulacija (cena, marža, material)
  note          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  bom Bom?
}

// ═══════════════════════════════════════════════════════════════════════════
// SKLADIŠČNI TOK (R443 — issue #7 §7, P1 INVENTORY CORE)
// VEČNO LOČENO: FIZIČNA ZALOGA (InventoryItem.qty) ≠ REZERVIRANA (Σ aktivnih
// rezervacij) ≠ RAZPOLOŽLJIVA (fizična − rezervirana).
// StockMovement = nemutabilni dnevnik vseh gibanj (prevzem/izdaja/vračilo/inventura).
// ═══════════════════════════════════════════════════════════════════════════

model StockMovement {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation("stockMovements", fields: [itemId], references: [id])
  qty       Float // + prevzem/vračilo; − izdaja/inventurni minus
  type      String // PREVZEM | IZDAJA | VRACILO | INVENTURA
  refType   String? // pickingList | materialOrder | rocni
  refId     String?
  userId    String?
  user      User?         @relation("stockMovements", fields: [userId], references: [id], onDelete: SetNull)
  note      String?
  createdAt DateTime      @default(now())

  @@index([itemId, createdAt])
}

model StockReservation {
  id         String        @id @default(cuid())
  itemId     String
  item       InventoryItem @relation("stockReservations", fields: [itemId], references: [id])
  qty        Float
  status     String        @default("AKTIVNA") // AKTIVNA | PORABLJENA | PREKLICANA
  projectId  String?
  project    Project?      @relation("stockReservations", fields: [projectId], references: [id], onDelete: SetNull)
  bomId      String?
  bom        Bom?          @relation("bomReservations", fields: [bomId], references: [id], onDelete: SetNull)
  userId     String?
  note       String?
  createdAt  DateTime      @default(now())
  consumedAt DateTime?

  @@index([itemId, status])
}

// Picking list — skladiščno zbiranje (picking) materiala za kosovnico
model PickingList {
  id        String   @id @default(cuid())
  code      String   @unique // npr. PICK-2026-001
  bomId     String?
  bom       Bom?     @relation("bomPickings", fields: [bomId], references: [id], onDelete: SetNull)
  status    String   @default("PRIPRAVLJENA") // PRIPRAVLJENA | V_ZAKLJUCEVANJU | ZAKLJUCENA | PREKLICANA
  note      String?
  userId    String? // skladiščnik, ki je pripravil
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines PickingLine[]
}

model PickingLine {
  id            String        @id @default(cuid())
  pickingListId String
  pickingList   PickingList   @relation(fields: [pickingListId], references: [id], onDelete: Cascade)
  itemId        String
  item          InventoryItem @relation("pickingLines", fields: [itemId], references: [id])
  qtyNeeded     Float // potrebno (iz vrstice kosovnice)
  qtyPicked     Float         @default(0) // dejansko pobrano
  note          String?
}
