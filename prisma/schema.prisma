// Roksal Railing Manager — REKONSTRUKCIJA (R431)
// Vir: blueprint iz GitLab recovery repo (route-map, RBAC katalog R425–R428, IA register R429)
// R464: PostgreSQL (produkcija + razvoj prek embedded-postgres / CI service) — SQLite obdobje končano
// SPORAZUM: ta shema je EN VIR — module (subagenti) NE spreminjajo sheme!

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identiteta & dostop ────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String // ADMIN | VODJA | MONTER | SKLADISCE | PROIZVODNJA
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  auditLogs    AuditLog[]
  workOrders   WorkOrder[]     @relation("assignee")
  woEvents     WorkOrderEvent[]
  measurements Measurement[]
  measVersions MeasurementVersion[] @relation("measurementVersions")
  equipHeld    Equipment[]     @relation("equipmentHolder")
  equipLogs    EquipmentCheckout[] @relation("equipmentUser")
  qcChecks     QcCheck[]       @relation("qcUser")
  jobRuns      JobRun[]
  punchEntries PunchEntry[]    @relation("punchUser") // R437: prisotnost
  stockMovements StockMovement[] @relation("stockMovements") // R443: skladiščni dnevnik
  checklistDone InstallationChecklist[] @relation("checklistDone") // R444: odkljukane točke
  materialUsage InstallationMaterialUsage[] @relation("usageUser") // R444: poraba na terenu
  drivenDeliveries Delivery[] @relation("drivenDeliveries") // R445: dostave, kjer je voznik
  serviceVisits   ServiceVisit[] @relation("serviceVisits") // R446: servisni obiski tehnika
  decidedCases    ServiceCase[] @relation("decidedCases") // R446: servisni primeri, ki jih je odločil
  catalogVersions CatalogVersion[] @relation("catalogVersions") // R449: verzije kataloga (issue #8)
  ruleVersions    RuleVersion[] @relation("ruleVersions") // R449: verzije inženirskih pravil (issue #8)
  arSnapshots     ArSnapshot[] @relation("arSnapshots") // R454: AR posnetki avtorja (3D/AR P3)
  vizProjects     VizProject[] @relation("vizProjects") // R454: shranjeni 3D projekti avtorja
  playbookDefs    PlaybookDef[] @relation("playbookAuthor") // R458: avtor verzije playbooka (issue #13)
  playbookRuns    PlaybookRun[] @relation("playbookUser") // R458: zagoni playbookov uporabnika
  photoViz        PhotoVisualization[] @relation("photoVizAuthor") // R459: foto-vizualizacije avtorja (issue #14)
  photoVizVersions PhotoVisualizationVersion[] @relation("photoVizVersions") // R459: verzije, ki jih je zapisal uporabnik
  fenceRuns       FenceRun[] @relation("fenceRuns") // R460: ograjni tekači avtorja (issue #15)
  fenceRunVersions FenceRunVersion[] @relation("fenceRunVersions") // R460: verzije tekačev, ki jih je zapisal uporabnik
  captureSessions CaptureSession[] @relation("captureAuthor") // R461: zajemi avtorja (issue #16)
  captureRefs     CaptureReference[] @relation("captureOperator") // R461: operator referenc (issue #16 §4)
  twinSnapshots   DigitalTwinSnapshot[] @relation("twinSnapshots") // R461: avtorji dvojčkovih snapshotov (issue #16)
  geoRefs         GeoReference[] @relation("geoOperator") // R462: operator georeferenc (issue #17 §1)
  registrations   Registration[] @relation("regAuthor") // R462: avtorji registracij (issue #17 §3)
  loopClosures    LoopClosure[] @relation("loopAuthor") // R462: avtorji loop checkov (issue #17 §5)
  productionElements ProductionElement[] @relation("productionElements") // R465: zadnji spreminjalci prefab elementov (issue #4)
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// ─── CRM ────────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  taxId     String?
  note      String?
  createdAt DateTime @default(now())

  projects Project[]
  quotes   Quote[]
  leads    Lead[]
  claims   Claim[] // R446: reklamacije stranke (issue #7 §10)
}

model Lead {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  name       String
  email      String?
  phone      String?
  source     String    @default("SPLET") // SPLET | TELEFON | PRIPOROČILO | SEJEM
  status     String    @default("NOV") // NOV | KONTAKTIRAN | KVALIFIKACIJAN | IZGUBLJEN | PRETVORJEN
  note       String?
  createdAt  DateTime  @default(now())

  opportunities Opportunity[]
}

model Opportunity {
  id           String    @id @default(cuid())
  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id])
  title        String
  stage        String    @default("KVALIFIKACIJA") // KVALIFIKACIJA | PONUDBA | POGAJANJA | ZMAGOVALNA | IZGUBLJENA
  value        Decimal @db.Decimal(12,2) @default(0)
  probability  Int       @default(50)
  expectedClose DateTime?
  note         String?
  createdAt    DateTime  @default(now())
}

// ─── Projekti & ponudbe ─────────────────────────────────────────────────────

model Project {
  id         String    @id @default(cuid())
  code       String    @unique // npr. P-2026-001
  title      String
  status     String    @default("AKTIVNI") // NACRT | AKTIVNI | TEREN | ZAKLJUCEN | ARHIV
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  address    String?
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  quotes           Quote[]
  workOrders       WorkOrder[]
  measurements     Measurement[]
  invoices         Invoice[]
  productionOrders ProductionOrder[]
  warranties       Warranty[]
  portalLinks      PortalLink[]
  packages         ProjectPackage[] // R442: več produktnih paketov na projekt
  stockReservations StockReservation[] @relation("stockReservations") // R443: rezervacije materiala
  deliveries       Delivery[] // R445: dostave projekta (issue #7 §9)
  claims           Claim[] // R446: reklamacije vezane na projekt (issue #7 §10)
  serviceCases     ServiceCase[] // R446: servisni primeri projekta
  arSnapshots      ArSnapshot[] // R454: AR posnetki projekta (3D/AR P3)
  vizProjects      VizProject[] // R454: shranjene 3D konfiguracije
  playbookRuns     PlaybookRun[] // R458: zagoni playbookov na projektu (issue #13)
  photoViz         PhotoVisualization[] // R459: foto-vizualizacije projekta (issue #14)
  fenceRuns        FenceRun[] // R460: ograjni tekači projekta (issue #15)
  captureSessions  CaptureSession[] // R461: zajemi QA projekta (issue #16)
  twinSnapshots    DigitalTwinSnapshot[] // R461: digitalni dvojček projekta (issue #16)
}

model Quote {
  id         String    @id @default(cuid())
  code       String    @unique // npr. PON-2026-001
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  // R474 (issue #9 §5): ponudba je VEZANA na paket/kosovnico — sprememba mere/
  // SKU/obsega invalidira ponudbo (OSNUTEK/POSLAN → OSNUTEK; SPREJET/ZAKLENJEN
  // samo ZASTARELO zastavica — podpisanega dokumenta se ne spreminja tiho).
  packageId  String?
  package    ProjectPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  staleAt    DateTime? // kdaj je bila označena kot zastarela
  staleReason String? // človeško berljiv razlog (revizija ima več)
  status     String    @default("OSNUTEK") // OSNUTEK | POSLAN | SPREJET | ZAVRNJEN | ZAKLENJEN
  subtotal   Decimal @db.Decimal(12,2) @default(0)
  vat        Decimal @db.Decimal(12,2) @default(0)
  total      Decimal @db.Decimal(12,2) @default(0)
  note       String?
  signature  String? // podpis stranke (data URL)
  signedAt   DateTime?
  signedBy   String?
  createdAt  DateTime  @default(now())

  lines   QuoteLine[]
  invoices Invoice[]
}

model QuoteLine {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  qty         Float
  unitPrice   Decimal @db.Decimal(12,2)
  total       Decimal @db.Decimal(12,2)
}

model Invoice {
  id        String    @id @default(cuid())
  code      String    @unique // npr. RA-2026-001
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id])
  quoteId   String?
  quote     Quote?    @relation(fields: [quoteId], references: [id])
  status    String    @default("IZDAN") // OSNUTEK | IZDAN | DELNO_PLACAN | PLACAN | ZAPRT
  subtotal  Decimal @db.Decimal(12,2) @default(0)
  vat       Decimal @db.Decimal(12,2) @default(0)
  total     Decimal @db.Decimal(12,2) @default(0)
  paid      Decimal @db.Decimal(12,2) @default(0)
  dueDate   DateTime?
  note      String?
  createdAt DateTime  @default(now())

  payments Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal @db.Decimal(12,2)
  method    String   @default("NAKAZNICA") // NAKAZNICA | GOTOVINA | KARTICA
  reference String?
  createdAt DateTime @default(now())
}

// ─── Nalogi (terenski tok) ──────────────────────────────────────────────────

model WorkOrder {
  id           String    @id @default(cuid())
  code         String    @unique // npr. N-2026-001
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id])
  title        String
  status       String    @default("NAPROGRAMIRAN") // NAPROGRAMIRAN | V_TEKU | V_ZAJEMU | V_PREVERI | ZAKLJUCEN
  assigneeId   String?
  assignee     User?     @relation("assignee", fields: [assigneeId], references: [id])
  scheduledFor DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  summary      String?
  instructions String? // navodila za monterja (pisarna → teren)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  events       WorkOrderEvent[]
  measurements Measurement[]
  // R444 (issue #7 §8 MONTER): kontrolni seznam + poraba materiala na terenu
  checklist    InstallationChecklist[]
  materialUsage InstallationMaterialUsage[]
  // R445 (issue #7 §9 DELIVERY + INSTALLATION): ekipa/podizvajalec na nalogu — ADITIVNO,
  // obstoječi tokovi nalogov (transition/termin/dodelitev) ostanejo nedotaknjeni
  crewId       String?
  crew         Crew?     @relation("crewWorkOrders", fields: [crewId], references: [id], onDelete: SetNull)
  deliveries   Delivery[]
  playbookRuns PlaybookRun[] // R458: vodeni postopki na nalogu (issue #13)
}

model WorkOrderEvent {
  id          String     @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])
  type        String // DODELJEN | ZACETEK | ZAJEM | PREVERITEV | ZAKLJUCEK | KOMENTAR | OPOMBA | TEZAVA (R439: sync; R444: TEZAVA — težave na terenu)
  note        String?
  createdAt   DateTime   @default(now())
}

// ─── Zajem (meritve, foto) ──────────────────────────────────────────────────

model Measurement {
  id          String      @id @default(cuid())
  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id])
  workOrderId String?
  workOrder   WorkOrder?  @relation(fields: [workOrderId], references: [id])
  authorId    String?
  author      User?       @relation(fields: [authorId], references: [id])
  type        String      @default("OGRAJA") // legacy tip (OGRAJA | BALUSTRADA | NAGIB | OSTANEO)
  familyCode  String? // R442: produktna družina (TERASA | OGRAJA_PRECNA | FASADA | …) — generalizacija meritev
  location    String?
  lengthCm    Float?
  heightCm    Float?
  posts       Int?
  segments    Int?
  handrail    Boolean     @default(true)
  slopeDeg    Float?
  source      String      @default("ROCNO") // ROCNO | KAMERA (večtočkovne meritve na fotografiji)
  params      String? // JSON (profileId, barva, photoId, points, calibration, viz, konfigurator …)
  note        String?
  // R437 (issue #2): javna deljena povezava meritve (žeton /m/[token] izvirnika → /api/public/measure?token=)
  shareToken  String?     @unique
  createdAt   DateTime    @default(now())

  versions    MeasurementVersion[]
  packages    ProjectPackage[] @relation("packageMeasurements") // R442: paketi, vezani na to izmero
  fenceRuns   FenceRun[] @relation("fenceRunMeasurements") // R460: tekači, potrjeni v to meritev (issue #15)
}

// Zgodovina verzij meritev — posnetek stanja ob vsaki spremembi (issue #1: zgodovina verzij)
model MeasurementVersion {
  id           String   @id @default(cuid())
  measurement  Measurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  measurementId String
  version      Int
  data         String   // JSON posnetek (type, lengthCm, heightCm, posts, slopeDeg, note, params …)
  userId       String?
  user         User?    @relation("measurementVersions", fields: [userId], references: [id])
  note         String?
  createdAt    DateTime @default(now())

  @@index([measurementId, version])
}

// ─── Katalog & zaloga ───────────────────────────────────────────────────────

model Profile {
  id          String  @id @default(cuid())
  sku         String  @unique
  name        String
  material    String  @default("ALU") // ALU | INOX | KOVANO ŽELEZO | STIKLO
  type        String  @default("OGRAJA") // OGRAJA | BALUSTRADA | NAGIBNA
  pricePerM   Decimal @db.Decimal(12,2) @default(0)
  description String?
  active      Boolean @default(true)

  versions    CatalogVersion[] // R449: zgodovina sprememb (issue #8)
}

// Zgodovina verzij profilov kataloga — posnetek CELEGA profila ob vsaki
// spremembi (R449, issue #8; vzorec MeasurementVersion iz issue #1):
// kdo/kdaj + staro→novo (data = JSON { before, after, profile }).
model CatalogVersion {
  id        String   @id @default(cuid())
  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation("catalogVersions", fields: [userId], references: [id])
  data      String   // JSON posnetek: { before: staro (le spremenjena polja | null pri novem), after: novo, profile: celoten posnetek }
  note      String?
  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([createdAt])
}

model InventoryItem {
  id        String   @id @default(cuid())
  sku       String   @unique
  name      String
  unit      String   @default("m") // m | kos | kg | l
  qty       Float    @default(0)
  reorderAt Float    @default(0)
  location  String?
  createdAt DateTime @default(now())

  lots   StockLot[]
  prices MaterialPrice[]
  // R442: produktni model — EKSPlicitne ID povezave (vir resnice za BOM)
  bomTemplates ProductComponent[] @relation("inBomTemplates")
  bomLines     BomLine[]          @relation("inBomLines")
  priceRules   PriceRule[]        @relation("itemPriceRules")
  // R443: skladiščni tok — gibanja, rezervacije, picking
  movements    StockMovement[]    @relation("stockMovements")
  reservations StockReservation[] @relation("stockReservations")
  pickingLines PickingLine[]      @relation("pickingLines")
  // R444: poraba materiala na terenu (MOJ DAN)
  usageItems   InstallationMaterialUsage[] @relation("usageItems")
  // R445: vrstice dostav (EKSPlicitna vezava, če vrstica izvira iz pickinga)
  deliveryItems DeliveryItem[] @relation("deliveryItems")
}

model StockLot {
  id          String   @id @default(cuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  qty         Float
  unitCost    Decimal @db.Decimal(12,2) @default(0)
  supplierId  String?
  deliveredAt DateTime @default(now())
}

model Supplier {
  id    String  @id @default(cuid())
  name  String
  email String?
  phone String?
  note  String?
}

model MaterialPrice {
  id         String        @id @default(cuid())
  itemId     String?
  item       InventoryItem? @relation(fields: [itemId], references: [id])
  supplierId String?
  price      Decimal @db.Decimal(12,2)
  createdAt  DateTime      @default(now())
}

// ─── Orodjarina (merilna orodja, izposoja) ──────────────────────────────────

model Equipment {
  id             String   @id @default(cuid())
  code           String   @unique // npr. OR-001
  name           String
  category       String   @default("MERITEV") // MERITEV | MONTAZA | PREVERITEV | VZDRZEVANJE
  serialNumber   String?
  status         String   @default("NA_VOLJO") // NA_VOLJO | IZPOSOJENO | V_SERVISU | POKVARJENO
  holderId       String? // trenutni imetnik (denormalizirano iz zadnje izposoje)
  holder         User?    @relation("equipmentHolder", fields: [holderId], references: [id])
  location       String?
  calibrationDue DateTime? // rok umeritve / kalibracije
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  checkouts EquipmentCheckout[]
}

model EquipmentCheckout {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation("equipmentUser", fields: [userId], references: [id])
  outAt       DateTime  @default(now())
  inAt        DateTime? // null = še izposojeno
  note        String?
}

// ─── Proizvodnja ────────────────────────────────────────────────────────────

model ProductionOrder {
  id        String    @id @default(cuid())
  code      String    @unique // npr. PR-2026-001
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id])
  title     String
  status    String    @default("NAVRTEN") // NAVRTEN | V_IZDELAVI | DOKONCAN | ODPOSLAN
  dueAt     DateTime?
  note      String?
  createdAt DateTime  @default(now())

  qcChecks QcCheck[]
  elements ProductionElement[] // R465: prefab elementi iz AS-PRODUCED dvojčka (issue #4)
}

// ─── PREFAB ENGINE (R465 — issue #4 §3) ─────────────────────────────────────
// Enota proizvodnje = SEGMENT digitalnega dvojčka (ključ seg-N iz snapshot-a).
// Mere/stebri/RAL so DENORMALIZIRAN posnetek AS-PRODUCED snapshot-a
// (proizvodni listič): snapshot ostaja verzioniran vir resnice (§22), element
// je delovni listič na proizvodni tekmi. ID snapshot-a se hrani kot navadno
// besedilo (enaka konvencija kot CaptureSession.snapshotId) — brisanje
// dvojčka ne sme izbrisati proizvodnje.
model ProductionElement {
  id                String   @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  sourceSnapshotId  String // AS-PRODUCED DigitalTwinSnapshot.id (vir mer)
  key               String // seg-N iz snapshot-a (stabilen ključ segmenta)
  label             String
  lengthCm          Float?
  heightCm          Float?
  posts             Int?
  ral               String?
  produkt           String? // izdelek/varianta iz snapshot-a
  status            String   @default("NAVRTEN") // NAVRTEN | REZANJE | IZDELAVA | POVRSINA | DOKONCAN
  note              String?
  userId            String?
  user              User?    @relation("productionElements", fields: [userId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([productionOrderId, key])
  @@index([productionOrderId])
}

// ─── Kontrola kakovosti (R434 — vir: /api/qc iz ROUTE-MAP) ──────────────────

model QcCheck {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  item              String // kontrolna točka, npr. "Vertikalnost stebričev"
  result            String          @default("V_TEKU") // OK | NOK | NA | V_TEKU
  note              String?
  userId            String?
  user              User?           @relation("qcUser", fields: [userId], references: [id])
  createdAt         DateTime        @default(now())
}

// ─── Garancija (R434 — vir: /api/warranty iz ROUTE-MAP) ─────────────────────

model Warranty {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startsAt  DateTime        @default(now())
  months    Int             @default(24)
  status    String          @default("AKTIVNA") // AKTIVNA | POTEKLA | PREKINJENA
  note      String?
  createdAt DateTime        @default(now())

  visits WarrantyVisit[]
  claims Claim[] // R446: reklamacije pod to garancijo (issue #7 §10)
  serviceCases ServiceCase[] // R446: servisni primeri, ki jih garancija pokriva
}

model WarrantyVisit {
  id         String    @id @default(cuid())
  warrantyId String
  warranty   Warranty  @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  date       DateTime  @default(now())
  note       String?
  userId     String?
  createdAt  DateTime  @default(now())
}

// ═══════════════════════════════════════════════════════════════════════════
// SERVIS — GARANCIJE / REKLAMACIJE / SERVIS (R446 — issue #7 §10, P2 SERVIS)
// Tok: STRANKA → REKLAMACIJA (Claim) → PREVERITEV → ODLOČITEV → SERVIS
//      (ServiceCase + ServiceVisit) → ZAKLJUČEK.
// Obstoječi Warranty/WarrantyVisit ostaja NEPOŠKODOVAN — zgolj razširjen z
// relacijami na reklamacije in servisne primere (aditivno, brez sprememb tokov).
// Eksplicitne ID povezave (customerId/projectId/packageId/warrantyId/claimId),
// BREZ fuzzy matchinga; PostgreSQL-kompatibilno (skalarni tipi brez seznamov).
// ═══════════════════════════════════════════════════════════════════════════

// REKLAMACIJA stranke (issue #7 §10) — vstopna točka servisa.
// Vezana na stranko + projekt (obvezno), paket in garancijo (opcijsko).
model Claim {
  id             String   @id @default(cuid())
  code           String   @unique // REK-2026-001
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  packageId      String? // kateri del projekta (paketa) se reklamacija tiče
  package        ProjectPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  warrantyId     String? // garancija, pod katero reklamacija spada (če obstaja)
  warranty       Warranty? @relation(fields: [warrantyId], references: [id], onDelete: SetNull)
  title          String
  desc           String // opis težave stranke
  channel        String   @default("TELEFON") // TELEFON | EMAIL | PORTAL | OSEBNO
  status         String   @default("NOVA") // NOVA | V_OBRAVNAVI | ZAKLJUCENA | ZAVRNJENA
  reportedBy     String? // ime prijavitelja, če ni uporabnik (npr. "Petra Horvat")
  resolutionNote String? // zaključna opomba pisarne
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  serviceCase   ServiceCase? // 1:1 — reklamacija vodi do (največ enega) servisnega primera

  @@index([customerId])
  @@index([projectId])
  @@index([status])
}

// SERVISNI PRIMER (issue #7 §10) — preveritev, odločitev, servis, zaključek.
// status: PREVERITEV → ODOBRENA | ZAVRNJENA; ODOBRENA → V_SERVISU | ZAKLJUCEN;
//         V_SERVISU → ZAKLJUCEN. decision: UTEMELJENA | DELNO_UTEMELJENA | NEUTEMELJENA.
model ServiceCase {
  id            String    @id @default(cuid())
  code          String    @unique // SRV-2026-001
  claimId       String?   @unique // iz reklamacije (1:1)
  claim         Claim?    @relation(fields: [claimId], references: [id], onDelete: SetNull)
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  warrantyId    String? // določa, ali garancija pokriva servis
  warranty      Warranty? @relation(fields: [warrantyId], references: [id], onDelete: SetNull)
  title         String
  desc          String
  status        String    @default("PREVERITEV") // PREVERITEV | ODOBRENA | V_SERVISU | ZAKLJUCEN | ZAVRNJENA
  decision      String? // UTEMELJENA | DELNO_UTEMELJENA | NEUTEMELJENA
  decisionNote  String?
  decidedById   String?
  decidedBy     User?     @relation("decidedCases", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  resolutionNote String?
  billable      Boolean   @default(false) // zaračunano stranki, če garancija ne pokriva
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  visits ServiceVisit[]

  @@index([projectId])
  @@index([status])
  @@index([claimId])
}

// SERVISNI OBISK (issue #7 §10) — tehnikov obisk na terenu z urami dela.
model ServiceVisit {
  id        String      @id @default(cuid())
  caseId    String
  case      ServiceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  date      DateTime    @default(now())
  userId    String // tehnik, ki je izvedel obisk
  user      User        @relation("serviceVisits", fields: [userId], references: [id])
  note      String
  hours     Float? // ur dela
  createdAt DateTime    @default(now())

  @@index([caseId, date])
}

// ─── Revizija & obvestila ───────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // npr. LOGIN, LOGOUT, QUOTE_ISSUE, PAYMENT_RECORD, WO_TRANSITION, USER_ROLE_CHANGE …
  entity    String // ime entitete (invoice, workOrder …)
  entityId  String?
  projectId String? // null = sistemski dogodek (R428: globalni pregled)
  detail    String? // JSON
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── Obvestila in komunikacija (R438: issue #5 — event → notification model) ─
// En poslovni dogodek (NotificationEvent) = en vir resnice; več kanalov
// (NotificationDelivery) porabi isti event. Retry je varen pred podvajanjem (key + unique).

model NotificationEvent {
  id        String   @id @default(cuid())
  key       String   @unique // dedup: npr. "wo-assign:<nalogId>:<assigneeId>"
  type      String // WO_ASSIGNED | WO_TERMIN | … (NOTIFICATION_EVENT_TYPES v notify-events.ts)
  payload   String // JSON { title, body, customerEmail?, customerName? }
  projectId String?
  createdAt DateTime @default(now())

  deliveries NotificationDelivery[]
}

model NotificationDelivery {
  id        String    @id @default(cuid())
  eventId   String
  event     NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  channel   String // IN_APP | EMAIL | SMS | WHATSAPP
  userId    String? // prejemnik-app uporabnik (IN_APP)
  recipient String? // prikriti zunanji naslov (e-pošta/telefon — NIKOLI celoten)
  status    String    @default("PENDING") // PENDING | SENT | FAILED | SKIPPED
  attempts  Int       @default(0)
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@unique([eventId, channel, userId]) // dedup dostave (userId null za zunanje)
  @@index([status, attempts])
}

// Nastavitve obveščanja po uporabniku (R438): event '*' = vsi dogodki.
model NotificationPref {
  id      String  @id @default(cuid())
  userId  String
  event   String // tip dogodka (ali * = vse)
  channel String // IN_APP | EMAIL | SMS
  enabled Boolean @default(true)

  @@unique([userId, event, channel])
}

// ─── Portal stranke (R435: /p/[token] izvirnika → javni API + predogled) ────

model PortalLink {
  id           String    @id @default(cuid())
  token        String    @unique // neuraden žeton URL /api/public/portal?token=…
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  note         String? // interne opombe (npr. "poslano na e-pošto")
  views        Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
}

// ─── Nastavitve sistema (R435: licenca/aktivacija, setup) ───────────────────

model Setting {
  key       String   @id // npr. "licence.key", "licence.status"
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Vzdrževalna opravila (R435: cron jobs izvirnika → ročni zagon + dnevnik) ─

model JobRun {
  id         String   @id @default(cuid())
  job        String // seje-gc | portal-gc | obvestila-gc
  ok         Boolean
  affected   Int      @default(0)
  detail     String? // JSON
  startedAt  DateTime
  finishedAt DateTime
  userId     String? // null = sistemski/cron zagon
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ─── Nabava materiala (R437: /api/material-orders iz route-mape izvirnika) ──

model MaterialOrder {
  id         String    @id @default(cuid())
  code       String    @unique // npr. NAR-2026-001
  supplierId String? // skalarno (enako kot MaterialPrice/StockLot)
  status     String    @default("PRIPRAVA") // PRIPRAVA | POSLANO | PREJETO | PREKINJENO
  note       String?
  createdBy  String?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?
  receivedAt DateTime?

  lines MaterialOrderLine[]
}

model MaterialOrderLine {
  id        String  @id @default(cuid())
  orderId   String
  order     MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    String? // povezava na artikel (opcijsko)
  itemName  String // denormalizirano ime (artikel lahko izgine)
  qty       Float
  unit      String  @default("m")
  unitPrice Decimal @db.Decimal(12,2) @default(0)
}

// ─── Prisotnost (R437: /api/punch iz route-mape izvirnika) ──────────────────

model PunchEntry {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("punchUser", fields: [userId], references: [id], onDelete: Cascade)
  day       String // lokalni dan YYYY-MM-DD
  inAt      DateTime?
  outAt     DateTime?
  note      String?
  createdAt DateTime  @default(now())

  @@unique([userId, day]) // ena prijava/odjava na dan
}

// ─── Inženirska pravila (R437: /api/engineering-rules iz route-mape) ────────

model EngineeringRule {
  id        String   @id @default(cuid())
  key       String   @unique // npr. max_razdalja_stebrov
  label     String // človeško berljivo ime
  value     Float
  unit      String   @default("cm")
  note      String?
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  versions  RuleVersion[] // R449: zgodovina vrednosti (issue #8)
}

// Zgodovina vrednosti inženirskega pravila (R449, issue #8): staro→novo ob
// vsaki spremembi (upsert/PATCH/deaktivacija) + kdo/kdaj.
// oldValue/newValue = JSON posnetka { value, label, unit, note, active }.
model RuleVersion {
  id        String         @id @default(cuid())
  ruleId    String
  rule      EngineeringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?          @relation("ruleVersions", fields: [userId], references: [id])
  oldValue  String? // JSON stanje PRED spremembo (null ob nastanku pravila)
  newValue  String // JSON stanje PO spremembi
  note      String?
  createdAt DateTime       @default(now())

  @@index([ruleId, createdAt])
}

// ─── Offline sinhronizacija (R439: issue #6 — mobilni teren brez signala) ────
// SyncOp = zadetek uspešno obdelanega opa iz /api/sync. id = opId (UUID, ga
// generira ODJEMALEC) → ponovno pošiljanje istega opId vrne shranjen rezultat
// (idempotenca — podvajanje meritev/dogodkov NI mogoče).

model SyncOp {
  id        String   @id // opId (UUID, generira odjemalec) — idempotenca
  deviceId  String
  userId    String
  kind      String // meritev | foto | nalog-opomba | nalog-status | nalog-zakljucek
  result    String // JSON odgovor operacije
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── Ankete / povpraševanja (R437: /api/surveys iz route-mape izvirnika) ────

model Survey {
  id        String   @id @default(cuid())
  name      String // ime kontaktirane osebe
  email     String?
  phone     String?
  type      String   @default("OGRAJA") // tip zahteve (OGRAJA | STOPNISCE | TERASA | DRUGO)
  lengthCm  Float? // ocenjena dolžina
  location  String?
  message   String?
  handled   Boolean  @default(false) // obdelano v pisarni
  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════════════════
// PRODUKTNI MODEL (R442 — issue #7 §1–§6, P0 DATA CORE)
// Vir resnice za izdelke, variante, komponente, BOM, cene in pakete projektov.
// Profile (zgoraj) ostaja kot LEGACY za stari railing konfigurator (viz/kalkulator)
// — nova poslovna logika MORA uporabljati ta model z EKSPPLICITNIMI ID povezavami.
// PostgreSQL-kompatibilno: samo skalarni tipi + JSON kot String (issue #7 §14).
// ═══════════════════════════════════════════════════════════════════════════

// ─── Produktna družina (issue #7 §1) ────────────────────────────────────────

model ProductFamily {
  id        String   @id @default(cuid())
  code      String   @unique // TERASA | OGRAJA_PRECNA | OGRAJA_POKOCNA | FASADA | PREGRADA | NAPUSC | STROP | STOPNICE | VRTNA_RESITEV | KOMPONENTA
  name      String
  desc      String?
  unit      String   @default("m2") // glavna enota družine: m2 | m | kos
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

// ─── Produkt (prodajni izdelek; issue #7 §1: SKU, enota, dimenzije, cene …) ─

model Product {
  id             String        @id @default(cuid())
  familyId       String
  family         ProductFamily @relation(fields: [familyId], references: [id])
  sku            String        @unique
  name           String
  desc           String?
  unit           String        @default("m2") // prodajna enota: m2 | m | kos
  // dimenzije (mm)
  widthMm        Int?
  heightMm       Int?
  depthMm        Int?
  // tehnične lastnosti (JSON): material, ral, obremenitev, toplotna prevodnost …
  tech           String?
  // osnovni ceni (nabavna/prodajna na enoto); veljavne cene razrešuje PriceList
  costPrice      Decimal @db.Decimal(12,2)       @default(0)
  salePrice      Decimal @db.Decimal(12,2)       @default(0)
  warrantyMonths Int           @default(24)
  active         Boolean       @default(true)
  validFrom      DateTime      @default(now())
  validTo        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  variants      ProductVariant[]
  components    ProductComponent[] @relation("bomTemplate")
  boms          Bom[]
  packages      ProjectPackage[]
  priceRules    PriceRule[]      @relation("productPriceRules")
  photoViz      PhotoVisualization[] @relation("photoVizProduct") // R459: foto-vizualizacije tega izdelka
  fenceRuns     FenceRun[] // R460: ograjni tekači v tem izdelku (issue #15)
}

// ─── Varianta produkta (barva/RAL, dimenzija; issue #7 §1) ──────────────────

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String   @unique
  name      String // npr. "WPC terasa — Grafit"
  color     String? // človeško berljivo ime barve
  ral       String? // npr. "RAL 7016"
  widthMm   Int?
  heightMm  Int?
  // override ceni (null = podeduje produkt)
  costPrice Decimal? @db.Decimal(12,2)
  salePrice Decimal? @db.Decimal(12,2)
  tech      String? // JSON dopolnilne tehnične lastnosti
  active    Boolean  @default(true)
  sortOrder Int      @default(0)

  packages ProjectPackage[]
  boms     Bom[]
  photoViz PhotoVisualization[] @relation("photoVizVariant") // R459: foto-vizualizacije v tej varianti
  fenceRuns FenceRun[] // R460: ograjni tekači v tej varianti (issue #15)
}

// ─── Komponenta produkta (BOM PREDLOGA; issue #7 §2) ────────────────────────
// EKSPlicitna ID povezava productId → itemId (InventoryItem).
// qty = količina artikla na ENOTO osnove (unitBasis) produkta.
// Primer: TERASA → WPC deska 1.05 m² na m² (vključen odpad).

model ProductComponent {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation("bomTemplate", fields: [productId], references: [id], onDelete: Cascade)
  itemId    String
  item      InventoryItem @relation("inBomTemplates", fields: [itemId], references: [id])
  qty       Float // količina na enoto osnove (oz. na enoto VLOGE, če je segmentRole nastavljena)
  unitBasis String        @default("m2") // m2 | m | kos — osnova produkta
  optional  Boolean       @default(false)
  note      String?
  sortOrder Int           @default(0)
  // R475 (issue #9 §5 — KOLIČINE IZ SEGMENTOV): vloga komponente v segmentni
  // matematiki. Če je nastavljena IN paket vsebuje segmente (calcJson.inputs.
  // segments), se količina vrstice izračuna PO SEGMENTU iz tekača/konfiguratorja
  // namesto predloga × skupna količina. Množitelj `qty` ima takrat semantiko
  // "na enoto vloge": STEBER → kos/steber, ROCNIK → m na m segmenta,
  // POLNILO_M → m na m segmenta, POLNILO_M2 → m² na m² polnila.
  // Null = predloga × količina (obnašanje do R474, nespremenjeno).
  segmentRole String? // STEBER | ROCNIK | POLNILO_M | POLNILO_M2
}

// ─── Kosovnica (generirana BOM; issue #7 §2 + §5) ───────────────────────────
// Nastane iz predloge (ProductComponent) × količina paketa.
// Vrstice kazajo EKSPlicitno na InventoryItem — nikoli na imena.

model Bom {
  id        String           @id @default(cuid())
  code      String           @unique // npr. BOM-2026-001
  packageId String?           @unique // povezava na projektni paket (izmera/ponudba; 1:1)
  package   ProjectPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  productId String
  product   Product          @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant?  @relation(fields: [variantId], references: [id])
  qty       Float // količina (v enoti produkta)
  unit      String // m2 | m | kos
  status    String           @default("OSNUTEK") // OSNUTEK | POTRJEN | REZERVIRAN | PORABLJEN | PREKLICAN
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  lines BomLine[]
  // R443: skladiščni tok vezan na kosovnico
  reservations StockReservation[] @relation("bomReservations")
  pickings     PickingList[]      @relation("bomPickings")
}

model BomLine {
  id        String        @id @default(cuid())
  bomId     String
  bom       Bom           @relation(fields: [bomId], references: [id], onDelete: Cascade)
  itemId    String // EKSPlicitna povezava na artikel
  item      InventoryItem @relation("inBomLines", fields: [itemId], references: [id])
  qty       Float
  unit      String
  note      String?
  sortOrder Int           @default(0)
  // R475 (issue #9 §5 — vrstica BOM ← segment): vezava vrstice na segment
  // tekača/konfiguratorja (seg-1, seg-2 … — isti ključi kot digitalni dvojček,
  // prefab lističi in merilni model R473). Null = vrstica brez segmenta
  // (pripadnosti/priprava — predloga × skupna količina).
  segmentKey String?
  // R475: skupina pozicij za prikaz/sume (STEBRI | ROCNIK | POLNILO | OSTALO).
  group      String?
  // R475: upoštevani odpad rezanja v % (vir: EngineeringRule odpad_rez_pct).
  wastePct   Float?
  // R475: ključ pravila/vnosa, iz katerega je količina izpeljana
  // (max_razdalja_stebrov | odpad_rez_pct | vnos:razmik) — revizijska sled.
  sourceRule String?
}

// ─── Ceniki (issue #7 §6: poslovne cene NISO hardcoded) ─────────────────────

model PriceList {
  id        String   @id @default(cuid())
  name      String // npr. "Prodajni cenik 2026"
  type      String   @default("PRODAJNA") // NABAVNA | PRODAJNA | MONTAZA
  currency  String   @default("EUR")
  validFrom DateTime @default(now())
  validTo   DateTime?
  active    Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules PriceRule[]
}

model PriceRule {
  id          String        @id @default(cuid())
  priceListId String
  priceList   PriceList     @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  // cilj pravila: produkt (prodajna cena) ali artikel (nabavna/montažna)
  productId   String?
  product     Product?      @relation("productPriceRules", fields: [productId], references: [id], onDelete: Cascade)
  itemId      String?
  item        InventoryItem? @relation("itemPriceRules", fields: [itemId], references: [id], onDelete: Cascade)
  price       Decimal @db.Decimal(12,2)
  unit        String        @default("m2")
  discountPct Float         @default(0)
  minPrice    Decimal? @db.Decimal(12,2) // najnižja dovoljena cena
  seasonFrom  String? // MM-DD (sezonska cena)
  seasonTo    String? // MM-DD
  note        String?
  active      Boolean       @default(true)
  validFrom   DateTime      @default(now())
  validTo     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([priceListId, active])
}

// ─── Projektni paket (issue #7 §3: projekt = več rešitev) ───────────────────
// Primer: P-2026-014 → TERASA 36,4 m² + OGRAJA 18,6 m + NAPUŠČ 24 m².

model ProjectPackage {
  id            String          @id @default(cuid())
  code          String          @unique // npr. PAK-P-2026-014-1
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  measurementId String? // povezava na izmero (generalizirana)
  measurement   Measurement?    @relation("packageMeasurements", fields: [measurementId], references: [id], onDelete: SetNull)
  name          String // prikazno ime, npr. "Terasa — WPC Grafit"
  qty           Float           @default(0) // količina v enoti produkta
  unit          String          @default("m2")
  status        String          @default("POVPRAŠEVANJE") // POVPRAŠEVANJE | IZMERA | KONFIGURACIJA | PONUDBA | POTRJENO | REZERVIRANO | V_IZDELAVI | DOSTAVLJENO | MONTIRANO | PREDANO
  calcJson      String? // JSON kalkulacija (cena, marža, material)
  note          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  bom Bom?
  quotes Quote[] // R474: invalidacija ob spremembi obsega
  claims Claim[] // R446: reklamacije, ki se tičejo tega paketa (issue #7 §10)
}

// ═══════════════════════════════════════════════════════════════════════════
// SKLADIŠČNI TOK (R443 — issue #7 §7, P1 INVENTORY CORE)
// VEČNO LOČENO: FIZIČNA ZALOGA (InventoryItem.qty) ≠ REZERVIRANA (Σ aktivnih
// rezervacij) ≠ RAZPOLOŽLJIVA (fizična − rezervirana).
// StockMovement = nemutabilni dnevnik vseh gibanj (prevzem/izdaja/vračilo/inventura).
// ═══════════════════════════════════════════════════════════════════════════

model StockMovement {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation("stockMovements", fields: [itemId], references: [id])
  qty       Float // + prevzem/vračilo; − izdaja/inventurni minus
  type      String // PREVZEM | IZDAJA | VRACILO | INVENTURA
  refType   String? // pickingList | materialOrder | rocni
  refId     String?
  userId    String?
  user      User?         @relation("stockMovements", fields: [userId], references: [id], onDelete: SetNull)
  note      String?
  createdAt DateTime      @default(now())

  @@index([itemId, createdAt])
}

model StockReservation {
  id         String        @id @default(cuid())
  itemId     String
  item       InventoryItem @relation("stockReservations", fields: [itemId], references: [id])
  qty        Float
  status     String        @default("AKTIVNA") // AKTIVNA | PORABLJENA | PREKLICANA
  projectId  String?
  project    Project?      @relation("stockReservations", fields: [projectId], references: [id], onDelete: SetNull)
  bomId      String?
  bom        Bom?          @relation("bomReservations", fields: [bomId], references: [id], onDelete: SetNull)
  userId     String?
  note       String?
  createdAt  DateTime      @default(now())
  consumedAt DateTime?

  @@index([itemId, status])
}

// Picking list — skladiščno zbiranje (picking) materiala za kosovnico
model PickingList {
  id        String   @id @default(cuid())
  code      String   @unique // npr. PICK-2026-001
  bomId     String?
  bom       Bom?     @relation("bomPickings", fields: [bomId], references: [id], onDelete: SetNull)
  status    String   @default("PRIPRAVLJENA") // PRIPRAVLJENA | V_ZAKLJUCEVANJU | ZAKLJUCENA | PREKLICANA
  note      String?
  userId    String? // skladiščnik, ki je pripravil
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines PickingLine[]
  deliveries Delivery[] // R445: dostave, ki so nastale iz te picking liste
}

model PickingLine {
  id            String        @id @default(cuid())
  pickingListId String
  pickingList   PickingList   @relation(fields: [pickingListId], references: [id], onDelete: Cascade)
  itemId        String
  item          InventoryItem @relation("pickingLines", fields: [itemId], references: [id])
  qtyNeeded     Float // potrebno (iz vrstice kosovnice)
  qtyPicked     Float         @default(0) // dejansko pobrano
  sortOrder     Int           @default(0) // vrstni red iz kosovnice (R443)
  note          String?

  @@index([pickingListId, sortOrder])
}

// ═══════════════════════════════════════════════════════════════════════════
// MONTERJEV DAN (R444 — issue #7 §8, P1 ROLE EXPERIENCES)
// Kontrolni seznam + poraba materiala na montažnem nalogu (mobile-first MOJ DAN).
// ═══════════════════════════════════════════════════════════════════════════

// kontrolni seznam za montažni nalog (issue #7 §8 MONTER: checklist)
model InstallationChecklist {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  label       String // npr. "Preverjena vodovodna instalacija"
  done        Boolean   @default(false)
  doneAt      DateTime?
  doneById    String?
  doneBy      User?     @relation("checklistDone", fields: [doneById], references: [id])
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([workOrderId, sortOrder])
}

// poraba materiala na terenu (issue #7 §8 MONTER: poraba materiala)
// Količinsko se zaznamuje prek StockMovement (IZDAJA, refType=workOrder) —
// ta zapis je vez na nalog z opombo in avtorjem (kdo je porabil).
model InstallationMaterialUsage {
  id          String            @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  itemId      String
  item        InventoryItem     @relation("usageItems", fields: [itemId], references: [id])
  qty         Float // vedno > 0
  note        String?
  userId      String?
  user        User?             @relation("usageUser", fields: [userId], references: [id])
  createdAt   DateTime          @default(now())

  @@index([workOrderId])
}

// ═══════════════════════════════════════════════════════════════════════════
// DOSTAVA + MONTAŽA (R445 — issue #7 §9, P1 DELIVERY + INSTALLATION)
// Vozila, dostave s tokom NAČRTOVANO → PRIPRAVLJENO → NATOVARJENO → NA_POTI →
// DOSTAVLJENO (+ PREKLICANA), ekipe/podizvajalci z regijo, tipi del,
// razpoložljivostjo, ceno, kakovostjo in zgodovino/reklamacijami.
// Dostava je vezana na: projekt, picking listo (skladišče/rezervacija),
// montažni termin (delovni nalog), vozilo in voznika (odgovorno osebo).
// ═══════════════════════════════════════════════════════════════════════════

// VOZILO za dostavo (issue #7 §9)
model Vehicle {
  id           String   @id @default(cuid())
  plate        String   @unique // registrska oznaka
  name         String // npr. "Fiat Ducato — odprt"
  capacityNote String? // opis nosilnosti/prostora
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  deliveries Delivery[]
}

// DOSTAVA — tok NAČRTOVANO → PRIPRAVLJENO → NATOVARJENO → NA_POTI → DOSTAVLJENO (issue #7 §9)
model Delivery {
  id            String   @id @default(cuid())
  code          String   @unique // DEL-2026-001
  status        String   @default("NACRTOVANO") // NACRTOVANO | PRIPRAVLJENO | NATOVARJENO | NA_POTI | DOSTAVLJENO | PREKLICANA
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  pickingListId String? // vezava na skladišče (picking)
  pickingList   PickingList? @relation(fields: [pickingListId], references: [id], onDelete: SetNull)
  workOrderId   String? // montažni termin (delovni nalog)
  workOrder     WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  vehicleId     String?
  vehicle       Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId      String? // odgovorna oseba / voznik
  driver        User?    @relation("drivenDeliveries", fields: [driverId], references: [id], onDelete: SetNull)
  plannedAt     DateTime? // načrtovani čas dostave
  loadedAt      DateTime? // NATOVARJENO
  departedAt    DateTime? // NA_POTI
  deliveredAt   DateTime? // DOSTAVLJENO
  address       String?
  recipientNote String? // prevzemnik / podpis na mestu
  note          String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items DeliveryItem[]
  @@index([status, plannedAt])
}

// Vrstica dostave — EKSPlicitna ID povezava na artikel, če izvira iz pickinga
// (NI fuzzy matchinga); description je prikazno ime (SKU + ime artikla).
model DeliveryItem {
  id          String    @id @default(cuid())
  deliveryId  String
  delivery    Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  itemId      String? // EKSPlicitna vezava na artikel, če je iz pickinga (ni fuzzy!)
  item        InventoryItem? @relation("deliveryItems", fields: [itemId], references: [id], onDelete: SetNull)
  description String // prikazno ime vrstice
  qty         Float
  unit        String
  note        String?

  @@index([deliveryId])
}

// EKIPA / PODIZVAJALEC (issue #7 §9: interne monterje, ekipe in podizvajalce
// z regijo, tipi del, razpoložljivostjo, ceno, kakovostjo, zgodovino in reklamacijami)
model Crew {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("INTERNA") // INTERNA | PODIZVAJALEC
  region       String? // npr. "Gorenjska"
  contactName  String?
  contactPhone String?
  contactEmail String?
  workTypes    String? // tipi del: "terase, ograje, fasade"
  availabilityNote String? // razpoložljivost
  priceNote    String? // dogovorjena cena/referenca
  rating       Int? // kakovost 1–5
  active       Boolean  @default(true)
  note         String? // zgodovina, reklamacije — opombe
  createdAt    DateTime @default(now())

  workOrders WorkOrder[] @relation("crewWorkOrders")
}

// ═══════════════════════════════════════════════════════════════════════════
// NAPREDNI 3D + AR (R454 — issue #7 §16 P3, route-map §„3D vizualizacije & AR")
// Vztrajnost AR zajemov (posnetek + VLM analiza prizora) in shranjenih 3D
// konfiguracij vizualizacije (viz.tsx) — doslej sta bila modula brez strežniške
// shrambe. Eksplicitne ID povezave na projekt in avtorja (§15).
// ═══════════════════════════════════════════════════════════════════════════

// AR POSNETEK — zajem iz AR predogleda (kamera/demo + ograja overlay)
// + rezultat VLM analize prizora (POST /api/ar/analyze): opis prizora,
// predlogi položaja ograje, ovire, reference za oceno mer.
model ArSnapshot {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  authorId  String?
  author    User?    @relation("arSnapshots", fields: [authorId], references: [id], onDelete: SetNull)
  scene     String? // kratek opis prizora (VLM), npr. „terasa z vhodnimi vrati"
  analysis  String? // JSON { placement: [{label, where, estLenCm?, note?}], obstacles: [], references: [] }
  params    String? // JSON { photo, posts, heightCm, scale, opacity, mode } — posnetek + nastavitve
  sceneJson String? // R467 (issue #8 F1): JSON SceneUnderstandingResult {version, elements[], edits[]} — živi razredi prizora ob zajemu; edits = označeni popravki monterja (izvirnik se ne prepisuje)
  note      String?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

// SHRANJEN 3D PROJEKT — konfiguracija vizualizacije (viz.tsx) za ponovno
// uporabo/podvajanje: tip, dimenzije, barva, profil, nagib … (params = JSON
// konfiguratorja). Vezava na poslovni projekt je neobvezna.
model VizProject {
  id        String   @id @default(cuid())
  name      String
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  authorId  String?
  author    User?    @relation("vizProjects", fields: [authorId], references: [id], onDelete: SetNull)
  tip       String   @default("OGRAJA") // OGRAJA | BALUSTRADA | NAGIB
  params    String // JSON konfiguratorja (lengthCm, heightCm, posts, segments, handrail, colorId, profileId, slopeDeg, montaza …)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, updatedAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// REALISTIC PHOTO REPLACEMENT (R459 — issue #14: fotorealistična menjava
// obstoječe ograje na ORIGINALNI fotografiji). Ločen PHOTO sloj nad parametrično
// 3D vizualizacijo (viz.tsx/viz-3d.tsx ostajata nedotaknjeni — §8 brez podvajanja).
// §12 single source of truth: EKSPPLICITNE ID povezave (projectId, measurementId
// + verzija, productId, variantId) — nikoli fuzzy matching.
// §13 revizija: kdo/kdaj/iz katere fotografije/iz katere verzije meritve/kateri
// produkt/barva/engine → AuditLog + verzijski posnetki (stare variante NISO tiho
// prepisane — vsaka sprememba renderParams ustvari novo verzijo).
// ═══════════════════════════════════════════════════════════════════════════

// FOTO-VIZUALIZACIJA — ena shranjena varianta (A/B/C) na projektu.
// sourcePhoto = data URL ORIGINALNE fotografije (ostane vir slike, §1);
// rendered = izrisana POTEM sličica (za PDF/portal); renderParams = deterministični
// vhod engine-a (quad + referenca + konfiguracija) — reproducibilno iz risanja.
model PhotoVisualization {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId      String?
  author        User?    @relation("photoVizAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  variantLabel  String   @default("A") // A | B | C (§7 primerjava variant)
  status        String   @default("OSNUTEK") // OSNUTEK | IZBRANA | ARHIV
  sourcePhoto   String // data URL (image/jpeg) originalne fotografije — ≤ 4 MB
  sourcePhotoId String? // meritev tip FOTO, iz katere izhaja fotografija (sledljivost §13)
  measurementId String? // POTRJENA meritev (geometrija §6)
  measurementVersion Int? // snapshot verzije meritve ob ustvarjanju (§12/§13)
  productId     String // ROKSAL izdelek — edini vir videza (§2)
  product       Product  @relation("photoVizProduct", fields: [productId], references: [id])
  variantId     String? // varianta produkta (barva/RAL, §3)
  variant       ProductVariant? @relation("photoVizVariant", fields: [variantId], references: [id], onDelete: SetNull)
  engineVersion String // verzija render engine-a (photo-replace-core)
  renderParams  String // JSON: { quad, reference, config } — BREZ fotografije (≤ 8 KB)
  rendered      String? // data URL izrisane POTEM sličice z žigom (≤ 2,5 MB)
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  versions PhotoVisualizationVersion[]

  @@index([projectId, status])
  @@index([projectId, variantLabel])
}

// VERZIJA FOTO-VIZUALIZACIJE — posnetek renderParams ob vsaki spremembi (§12:
// nove verzije DA, tiho prepisovanje NE). data = JSON { renderParams, meta }.
model PhotoVisualizationVersion {
  id              String   @id @default(cuid())
  visualizationId String
  visualization   PhotoVisualization @relation(fields: [visualizationId], references: [id], onDelete: Cascade)
  version         Int
  data            String // JSON posnetek (brez blob fotografij)
  userId          String?
  user            User?    @relation("photoVizVersions", fields: [userId], references: [id], onDelete: SetNull)
  note            String?
  createdAt       DateTime @default(now())

  @@index([visualizationId, version])
}

// ═══════════════════════════════════════════════════════════════════════════
// PLAYBOOK ENGINE (R458 — issue #13: SCRIPT-FIRST FIELD WORKFLOW)
// Deterministični vodeni postopki brez runtime AI: PLAYBOOK → STEP → ACTION →
// VALIDATION → NEXT STEP. Definicije so PODATKOVNO definirane (JSON) in
// verzionirane; izvajanje je state-machine z revizijo vsakega prehoda.
// ═══════════════════════════════════════════════════════════════════════════

// DEFINICIJA PLAYBOOKA — verzioniran vir resnice (key + version edinstven).
// status: DRAFT (priprava) | ACTIVE (aktiven za nove zagone) | RETIRED (upokojen).
// §14: zaključeni zagoni ostanejo vezani na svojo verzijo prek snapshot polj na run-u.
model PlaybookDef {
  id            String   @id @default(cuid())
  key           String // OGRAJA | KERAMIKA | STREHA | FASADA | MONTAZA
  name          String
  version       Int // zaporedna verzija (1, 2, …)
  status        String   @default("DRAFT")
  effectiveFrom DateTime @default(now())
  authorId      String?
  author        User?    @relation("playbookAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  definition    String // JSON: { steps: [...], pravila } — podatkovno definirani workflow
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  runs PlaybookRun[]

  @@unique([key, version])
  @@index([key, status])
}

// ZAGON PLAYBOOKA — izvedba na nalogu/projektu. Snapshot key+version zagotavlja
// §14 vezavo na verzijo. context = odgovori na pogojna vprašanja (§5) +
// kontekst naprave (§9). handoff = sled avtomatskih prehodov (§11).
model PlaybookRun {
  id             String      @id @default(cuid())
  playbookDefId  String
  playbookDef    PlaybookDef @relation(fields: [playbookDefId], references: [id])
  playbookKey    String // snapshot (§14)
  playbookVersion Int // snapshot (§14)
  projectId      String?
  project        Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workOrderId    String?
  workOrder      WorkOrder?  @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  userId         String
  user           User        @relation("playbookUser", fields: [userId], references: [id])
  status         String      @default("V_TEKU") // V_TEKU | ZAKLJUCEN | PREKINJEN
  context        String? // JSON: { odgovori: { jeStopnisce: true, … }, naprava: { tier, … } }
  handoff        String? // JSON: [{ do: 'KONFIGURATOR', ob: ISO, runId }] (§11)
  startedAt      DateTime    @default(now())
  completedAt    DateTime?

  steps PlaybookStepRun[]

  @@index([workOrderId])
  @@index([userId, startedAt])
  @@index([projectId])
}

// KORAK ZAGONA — stanje posameznega koraka v izvedbi.
// status: PENDING | IN_PROGRESS | COMPLETED | NI_PRIMERNO (§6 izjema z razlogom)
//        | BLOKIRANO (§6 ovira z razlogom) | NEUSPESNO (validacija padla → ponovitev)
// evidence = JSON dokazila (§10): foto id, meritev id, vrednosti, checklist, podpis.
model PlaybookStepRun {
  id              String      @id @default(cuid())
  runId           String
  run             PlaybookRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId          String // id koraka iz definicije (stable identifier)
  status          String      @default("PENDING")
  evidence        String? // JSON dokazil (§10)
  exceptionReason String? // §6: obvezni razlog za NI_PRIMERNO / BLOKIRANO
  attempts        Int         @default(0) // število poskusov (retry podpora)
  startedAt       DateTime?
  completedAt     DateTime?
  updatedAt       DateTime    @updatedAt

  @@unique([runId, stepId])
}

// ═══════════════════════════════════════════════════════════════════════════
// ULTIMATE MEASUREMENT ENGINE — OGRAJNI TEKAČ (R460 — issue #15)
// Specializirana ograjna izmera po načelu ZAČETEK → STEBER → SEGMENT → … →
// KONEC (§1). Vozlišča (stebri/vogali/vrata/stopnice) + višinski profil terena
// (§12) dajo segmente z dolžino/padino/višinsko razliko; razpored vmesnih
// stebrov je PRODUKTNO zaveden (§8/§11 — max razpon iz tech JSON izdelka).
// Statusi dimenzij (§9): ESTIMATED → AUTO_SUGGESTED → MANUAL → CALIBRATED →
// VERIFIED (zunanji merilnik, §10) → CONFIRMED. POTRDITEV (§20/§21) ustvari
// kanonično Measurement + verzijo (+ neobvezen ProjectPackage) — en vir
// resnice, brez ponovnega vnosa (§17). Brez runtime AI (§18).
// ═══════════════════════════════════════════════════════════════════════════

// Ograjni tekač — vodena izmera ene ograje.
// nodes  = JSON vozlišč: [{ kind, atCm, heightCm?, pritrditev?, podlaga?,
//                          interiorDeg?, gateWcm?, note?, manual? }]
// terrain = JSON višinske točke: [{ distCm, elevCm }] (§12 — linearna interpolacija)
// calibration = JSON §4: { method, refObject?, refValueCm, device?,
//                          capturedAt?, confidence?, algorithmVersion? }
// quality = JSON §3 gate: { state, score, reasons[] } — posnetek ob potrditvi
model FenceRun {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workOrderId   String?
  authorId      String?
  author        User?          @relation("fenceRuns", fields: [authorId], references: [id], onDelete: SetNull)
  name          String
  status        String         @default("OSNUTEK") // OSNUTEK | PREGLED | POTRJEN | ARHIV
  productId     String?
  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  measurementId String? // kanonična meritev po potrditvi (§17/§21)
  measurement   Measurement?   @relation("fenceRunMeasurements", fields: [measurementId], references: [id], onDelete: SetNull)
  calibration   String? // JSON §4 — metoda + referenca + zaupanje
  terrain       String? // JSON §12 — višinski profil
  nodes         String? // JSON §1 — vozlišča tekača
  quality       String? // JSON §3 — quality gate posnetek
  note          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  segments FenceSegment[]
  versions FenceRunVersion[]
  captureSessions CaptureSession[] // R461: QA zajemi nad tekačem (issue #16 — sloj, ne podvajanje)

  @@index([projectId, updatedAt])
}

// Segment tekača — IZPELJAN iz vozlišč + terena (strežniški izračun ob vsaki
// spremembi). Vrstice se ohranijo (status/verifikacija), če se poziciji
// fromAt/toCm geometricko ujemata (±1 cm) — sicer POŠTENO razveljavljene
// (ESTIMATED v1, §19: sprememba geometrije razveljavi preveritev).
model FenceSegment {
  id           String    @id @default(cuid())
  fenceRunId   String
  fenceRun     FenceRun  @relation(fields: [fenceRunId], references: [id], onDelete: Cascade)
  order        Int
  fromKind     String // vrsta vozlišča na začetku segmenta
  toKind       String // vrsta vozlišča na koncu segmenta
  fromAtCm     Float // položaj začetka ob teku (cm)
  toAtCm       Float // položaj konca ob teku (cm)
  lengthCm     Float // 3D dolžina po terenu (cm)
  heightCm     Float? // višina polnila (cm, če znana)
  angleDeg     Float? // notranji kot v vogalu (samo pri VOGAL koncu)
  slopeDeg     Float // padina segmenta (deg, −90..90)
  heightDiffCm Float // višinska razlika konca (cm)
  posts        Int // vmesni stebri znotraj segmenta (razpon ≤ maxSpan)
  status       String    @default("ESTIMATED") // §9: ESTIMATED | AUTO_SUGGESTED | MANUAL | CALIBRATED | VERIFIED | CONFIRMED
  verifiedCm   Float? // izmerjeno z zunanjim merilnikom (§10)
  verifyMethod String? // LASER | MICNIK | DRUGO
  verifyNote   String?
  source       String    @default("ROCNO") // ROCNO | ENGINE
  version      Int       @default(1) // števec sprememb segmenta
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([fenceRunId, order])
}

// Zgodovina verzij tekača — posnetek CELEGA teka ob vsaki spremembi
// (vzorec MeasurementVersion iz issue #1; §17 sledljivost).
model FenceRunVersion {
  id         String   @id @default(cuid())
  fenceRunId String
  fenceRun   FenceRun @relation(fields: [fenceRunId], references: [id], onDelete: Cascade)
  version    Int
  userId     String?
  user       User?    @relation("fenceRunVersions", fields: [userId], references: [id])
  data       String   // JSON posnetek: { nodes, terrain, calibration, segments, status, quality }
  note       String?
  createdAt  DateTime @default(now())

  @@index([fenceRunId, version])
}

// ═══════════════════════════════════════════════════════════════════════════
// REALITY CAPTURE QA + DIGITAL TWIN (R461 — issue #16)
// QA, registracija, drift in verifikacijski sloj NAD obstoječim measurement
// engine-om (R455–R460): tekač ostaja vir geometrije, zajem doda pokritost,
// referenčno mrežo, drift kontrolo in AS-BUILT verifikacijo. Digitalni
// dvojček = enoten verzirani model AS-MEASURED → AS-DESIGNED → AS-PRODUCED
// → AS-INSTALLED z eksplicitnimi viri (§8/§21/§22). Brez runtime AI.
// ═══════════════════════════════════════════════════════════════════════════

// ZAJEM (capture session) — vodena izmera z QA. Nadstropje nad tekačem
// (mode FENCE_RUN) ali klasično kamero (mode KAMERA).
// device = JSON §15: { tier: PREMIUM|STANDARD|BASIC, caps }
// outdoor = JSON §16: { conditions: [], note }
// plan = JSON §2: [{ id, kind, label, atCm?, critical }] — vodena ruta
// state = JSON §17: { currentStopId, doneStops: [] } (prekinitev/nadaljevanje)
// coverage = JSON §1: { zones: [{ stopId, label, state, photoCount }], gate }
// drift = JSON §3: { samples: [{ offsetCm, atCm, ts }], status, lastRefCode }
model CaptureSession {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workOrderId String?
  fenceRunId  String?
  fenceRun    FenceRun? @relation(fields: [fenceRunId], references: [id], onDelete: SetNull)
  authorId    String?
  author      User?    @relation("captureAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  name        String
  status      String   @default("V_TEKU") // V_TEKU | ZAKLJUCEN | PREKINJEN
  mode        String   @default("FENCE_RUN") // FENCE_RUN | KAMERA
  device      String? // JSON §15 — zaznane zmožnosti naprave + izbrani režim
  outdoor     String? // JSON §16 — zunanji pogoji zajema
  plan        String? // JSON §2 — vodena ruta (postanki iz tekača/objekta)
  state       String? // JSON §17 — trenutni korak + opravljeni postanki
  coverage    String? // JSON §1 — živo stanje pokritosti (iz posnetkov)
  drift       String? // JSON §3 — vzorci registra + status drifta
  snapshotId  String? // AS-MEASURED snapshot, ustvarjen ob zaključku
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  references CaptureReference[]
  photos     CapturePhoto[]
  geoRefs    GeoReference[] // R462: georeference zajema (issue #17 §1/§2)
  registrations Registration[] // R462: verzionirane registracije (issue #17 §3)
  loopClosures  LoopClosure[] // R462: preverjanja zanke (issue #17 §5)

  @@index([projectId, updatedAt])
}

// REFERENČNA TOČKA (§4 multi-reference network) — veriga A → B → C → D.
// atCm = prijavljeni položaj ob teku; measureCm = ZUNANJE izmerjena razdalja
// od prejšnje aktivne reference. Engine preverja RELATIVNO skladnost verige;
// konflikt je izrecen (status KONFLIKT), nikoli tiho rešen.
model CaptureReference {
  id         String         @id @default(cuid())
  sessionId  String
  session    CaptureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  code       String // REF-001, REF-002, …
  label      String?
  atCm       Float // položaj ob teku (cm)
  measureCm  Float // razdalja od prejšnje AKTIVNE reference (cm, zunanje merilo)
  method     String // LASER | MICNIK | ZNANA_MERA | DRUGO
  device     String?
  operatorId String?
  operator   User?          @relation("captureOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  status     String         @default("AKTIVNA") // AKTIVNA | KONFLIKT | ZAVRACENA
  confidence Float? // 0..1 (iz metode, §4)
  note       String?
  createdAt  DateTime       @default(now())

  @@unique([sessionId, code])
  @@index([sessionId, atCm])
}

// POSNETEK ZAJEMA (§1/§24) — dokazilo pokritosti cone. BREZ blob-ov: same
// metapodatke kakovosti + neobvezno sličico (≤ 120 KB) za galerijo; celotne
// fotografije ostanejo tam, kjer že živijo (meritev/foto-vizualizacija).
// clientKey = idempotentnost za offline sync (§17: brez podvojenih posnetkov).
model CapturePhoto {
  id         String         @id @default(cuid())
  sessionId  String
  session    CaptureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clientKey  String // idempotenten ključ odjemalca (offline vrsta)
  zone       String // id postanka iz plan-a (cona pokritosti)
  quality    String? // JSON { dark, bright, blurry, blurScore? }
  offsetCm   Float? // odmik registra ob zajemu (drift vzorec, §3)
  thumb      String? // data URL sličice (≤ 120 KB, §24)
  capturedAt DateTime       @default(now())

  @@unique([sessionId, clientKey])
  @@index([sessionId, zone])
}

// SNAPSHOT DIGITALNEGA DVOJČKA (§8–§12/§22) — en model za vsa štiri stanja
// (kind), verzioniran PO VRSTI s povezavo na prejšnjo verzijo + razlogom.
// data = JSON struktiranega stanja objekta (segmenti/višine/koti/teren/
// podlaga/fotografije/konfiguracija …); sources = JSON eksplicitnih virov
// [{ vrsta, id, version? }] — vsak podatek ima jasen vir in sled.
model DigitalTwinSnapshot {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind       String // AS_MEASURED | AS_DESIGNED | AS_PRODUCED | AS_INSTALLED
  version    Int // zaporedna verzija ZA VRSTO na projektu
  parentSnapshotId String?
  parentSnapshot DigitalTwinSnapshot? @relation("twinChain", fields: [parentSnapshotId], references: [id], onDelete: SetNull)
  children   DigitalTwinSnapshot[] @relation("twinChain")
  data       String // JSON struktiranega stanja
  sources    String // JSON [{ vrsta, id, version? }]
  reason     String // razlog nastanka/spremembe (§22 — obvezno)
  createdFrom String? // captureSessionId | packageId | bomId | workOrderId
  userId     String?
  user       User?    @relation("twinSnapshots", fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@unique([projectId, kind, version])
  @@index([projectId, kind])
}


// ═══════════════════════════════════════════════════════════════════════════
// REALITY-TO-PRODUCTION (R462 — issue #17)
// Georeferenca (§1/§2), 3-točkovna registracija (§3) in loop closure (§5)
// kot nadstropje nad zajemi R461. Tolerance prihajajo IZKLJUČNO iz
// EngineeringRule (tol_* ključi) — brez ugibanj (§12). RTK koordinata NIKOLI
// samodejno ne postane proizvodna mera (§2). Vse verzionirano + audited.
// ═══════════════════════════════════════════════════════════════════════════

// GEOREFERENCA — sidro zajema v globalnem/polgeodetskem okviru (§1).
// tier: BASIC (kamera+lokalna) | PROFESSIONAL (AR/LiDAR+fizične točke) |
//       SURVEY (GNSS/RTK+referenčne točke).
// source: GNSS_RTK | GNSS_FLOAT | GNSS_NONE | LASER | MARKER | MANUAL.
// natančnost (hAccM/vAccM) je zgornja meja vira — brez lažne natančnosti.
model GeoReference {
  id              String   @id @default(cuid())
  sessionId       String
  session         CaptureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  code            String // GEO-001, GEO-002, …
  tier            String // BASIC | PROFESSIONAL | SURVEY
  lat             Float // stopinje (WGS84 ali podano v coordinateSystem)
  lon             Float
  altM            Float? // nadmorska višina (m)
  atCm            Float? // položaj ob teku (cm) — vezava na tekača
  coordinateSystem String  @default("WGS84")
  datum           String? // npr. ETRS89
  geoid           String? // npr. SVS2010
  hAccM           Float? // horizontalna natančnost (m) — ZGORNJA meja vira
  vAccM           Float? // vertikalna natančnost (m)
  source          String // GNSS_RTK | GNSS_FLOAT | GNSS_NONE | LASER | MARKER | MANUAL
  rtkStatus       String? // FIX | FLOAT | NONE (samo za GNSS vire)
  correctionAgeSec Float? // starost RTK korekcij (§2)
  device          String?
  operatorId      String?
  operator        User?   @relation("geoOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  status          String  @default("AKTIVNA") // AKTIVNA | KONFLIKT | ZAVRACENA
  note            String?
  createdAt       DateTime @default(now())

  @@unique([sessionId, code])
  @@index([sessionId, atCm])
}

// REGISTRACIJA MODELA (§3) — 3-točkovna podobnostna transformacija
// (translacija + rotacija + merilo). VERZIONIRANA: nova registracija = nova
// vrstica (nikoli prepis). points = JSON [{ code, source:{x,y}, target:{x,y} }],
// transform = JSON { tx, ty, rotationDeg, scale, orientation },
// quality: GOOD (RMS ≤ 1 cm) | WARNING (≤ 3 cm) | INVALID.
model Registration {
  id         String   @id @default(cuid())
  sessionId  String
  session    CaptureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  version    Int // zaporedna verzija registracije na zajemu
  points     String // JSON 3 para točk (source → target)
  transform  String // JSON { tx, ty, rotationDeg, scale, orientation }
  rmsCm      Float // residual RMS (cm) — utemeljena kakovost ujemanja
  quality    String // GOOD | WARNING | INVALID
  userId     String?
  user       User?    @relation("regAuthor", fields: [userId], references: [id], onDelete: SetNull)
  note       String?
  createdAt  DateTime @default(now())

  @@index([sessionId, version])
}

// LOOP CLOSURE (§5) — preverjanje začetka proti koncu dolgega/krožnega zajema.
// expectedCm = prijavljena razdalja (tek), measuredCm = zunanje merilo ob
// povratku. FAILED: označi konflikt, zahtevaj novo referenco — starih potrjenih
// meritev NE spreminjamo (§5), vse verzije ostanejo.
model LoopClosure {
  id            String   @id @default(cuid())
  sessionId     String
  session       CaptureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  startCode     String // referenca na začetku (REF-/GEO- koda ali START)
  endCode       String // referenji ob povratku
  expectedCm    Float // prijavljena razdalja po teku
  measuredCm    Float // zunanje izmerjena razdalja
  heightDiffCm  Float? // višinsko odstopanje (če izmerjeno)
  positionDiffCm Float // |measured − expected|
  status        String // LOOP_CLOSED | LOOP_WARNING | LOOP_FAILED
  userId        String?
  user          User?    @relation("loopAuthor", fields: [userId], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime @default(now())

  @@index([sessionId, createdAt])
}
